# Personal Mac extras — install after Brewfile.
# Run: brew bundle --file=macos/Brewfile.personal

tap "homebrew/bundle"
tap "homebrew/services"
tap "microsoft/mssql-release"
tap "modularml/packages"
tap "mongodb/brew"

# Dev tools
brew "fzf"
brew "git-lfs"
brew "gnupg"
brew "nvm"
brew "node"
brew "rustup"
brew "terraform"
brew "make"
brew "tree"
brew "wget"
brew "graphviz"
brew "helm"
brew "kubernetes-cli"
brew "huggingface-cli"
brew "awscli"
brew "uv"
brew "aws/tap/eks-node-viewer"
brew "derailed/k9s/k9s"

# Desktop apps
cask "discord"
cask "google-drive"
cask "figma"
cask "zoom"
cask "telegram"
cask "whatsapp"
cask "notion"
cask "obsidian"
cask "chatgpt"
cask "claude-code"
cask "steam"
cask "keycastr"
cask "dbeaver-community"
cask "imageoptim"
cask "shottr"
cask "nordvpn"
cask "calibre"
cask "libreoffice"
cask "stats"
